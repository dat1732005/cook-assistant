{
  "name": "cook-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trợ lý nấu ăn - Cooking Assistant MVP",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @cook/core build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "validate-data": "node scripts/validate-data.js",
    "backend:test": "cd apps/backend && mvnw test",
    "backend:build": "cd apps/backend && mvnw package -DskipTests",
    "backend:start": "java -jar apps/backend/target/backend-0.1.0-SNAPSHOT.jar",
    "backend:dev": "cd apps/backend && mvnw package -DskipTests && java -jar target/backend-0.1.0-SNAPSHOT.jar"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2"
  }
}
