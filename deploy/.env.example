# ==============================================================================
# File: deploy/.env.example
# Làm gì: Liệt kê toàn bộ biến môi trường triển khai Docker Compose / Production (T21.3).
# Quy tắc: CHỈ CHỨA TÊN BIẾN (không chứa bất kỳ giá trị thật hay bí mật nào).
# Hướng dẫn: Sao chép sang deploy/.env (đã nằm trong .gitignore) trước khi chạy:
#            cp deploy/.env.example deploy/.env
# ==============================================================================

# --- Reverse Proxy & Tên miền HTTPS (Caddy - VPS tự quản T21.7) ---
# Điền tên miền thật trỏ vào VPS để Caddy tự cấp HTTPS, hoặc để trống / :80 khi thử cục bộ không có tên miền
APP_DOMAIN=

# --- Cơ sở dữ liệu PostgreSQL nội bộ (dùng cho Docker Compose VPS) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Kết nối Spring Boot -> PostgreSQL ---
# Trên VPS để trống nếu dùng dịch vụ postgres trong docker-compose.yml; trên Managed DB điền URL kèm sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Bảo mật ẩn danh hóa thiết bị & Môi trường Spring Boot ---
# DEVICE_SALT tạo bằng: openssl rand -hex 32
DEVICE_SALT=
# COOK_ENV bắt buộc đặt tường minh: production (hoặc development / test khi thử cục bộ)
COOK_ENV=
PORT=
COOK_LOG_LEVEL=
JAVA_OPTS=

# --- Cấu hình Nhà cung cấp AI ---
# COOK_AI_PROVIDER bắt buộc đặt tường minh: real khi COOK_ENV=production
COOK_AI_PROVIDER=
COOK_AI_API_KEY=
COOK_AI_ENDPOINT_URL=
COOK_AI_MODEL=
COOK_AI_ASK_ENABLED=
COOK_AI_TIMEOUT_MS=

# --- Giới hạn lượt AI (Sliding Window) & CORS ---
COOK_RATE_LIMIT_LIMIT=
COOK_RATE_LIMIT_WINDOW_SECONDS=
COOK_CORS_ALLOWED_ORIGINS=
COOK_CORS_ALLOW_CREDENTIALS=
COOK_CORS_MAX_AGE_SECONDS=

