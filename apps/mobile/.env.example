# Mẫu biến môi trường build ứng dụng Android (T20.1)
# Không điền khóa bí mật hay mật khẩu vào tệp này; sử dụng EAS Secrets / Environment Variables cho preview và production.

# Môi trường ứng dụng: development | staging | production
APP_ENV=

# Địa chỉ gốc máy chủ backend Spring Boot (ví dụ cục bộ ở development hoặc https://... ở staging/production)
# Ở staging và production bắt buộc phải cấu hình; production bắt buộc dùng https://
API_BASE_URL=

